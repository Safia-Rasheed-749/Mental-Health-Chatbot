# Copy to .env locally; never commit real secrets.
MINDCARE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fyp_chatbot
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MIN=1
DB_POOL_MAX=10

# Generate a unique high-entropy value for each deployment.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOW_LEGACY_SHA256=false
BCRYPT_ROUNDS=12

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
APP_URL=http://localhost:8501

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
WHISPER_MODEL=base
